AUTH_SECRET=troque-esta-chave-local
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3030
DATABASE_URL=postgresql://cidadela:cidadela@127.0.0.1:5544/cidadela_agents
QDRANT_URL=http://127.0.0.1:6433
# QDRANT_API_KEY=
QDRANT_COLLECTION_SECURITY=rag_security
QDRANT_COLLECTION_SUPPORT=rag_support
QDRANT_COLLECTION_DEV=rag_dev
QDRANT_COLLECTION_DESKTOP=rag_desktop
QDRANT_STAGING_COLLECTION_SECURITY=rag_security_staging
QDRANT_STAGING_COLLECTION_SUPPORT=rag_support_staging
QDRANT_STAGING_COLLECTION_DEV=rag_dev_staging
QDRANT_STAGING_COLLECTION_DESKTOP=rag_desktop_staging
QDRANT_VECTOR_SIZE=1024
SOP_OUTPUT_DIR=./files/sop
SOP_READINESS_THRESHOLD=0.75
CURATION_REQUIRES_OWNER_APPROVAL=true
CURATION_REQUIRES_ADMIN_APPROVAL=true
CURATION_ALLOW_SAME_USER_DUAL_APPROVAL=true

# true => usa o Ollama nativo do host em http://127.0.0.1:11434 (e o profile
# "cpu" do docker-compose.local.yml nao precisa subir). false => usa a porta
# publicada pelo container (11500).
OLLAMA_HOST_MODE=false
# OLLAMA_URL=http://127.0.0.1:11500
# CONTAINER_OLLAMA_URL=http://ollama-cpu:11434
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_CHAT_MODEL=qwen3.5:4b
# Se vazio, o classificador reusa OLLAMA_CHAT_MODEL.
# OLLAMA_CLASSIFIER_MODEL=
RERANKER_ENABLED=false
# RERANKER_MODEL=bge-reranker-v2-m3

RABBITMQ_URL=amqp://cidadela:cidadela@127.0.0.1:5673
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15673
CHAT_TOP_K=5
# Score minimo do melhor chunk local para responder sem consultar outros setores.
CHAT_LOCAL_CONFIDENCE_THRESHOLD=0.50
BUS_RPC_TIMEOUT_MS=60000
BUS_BOOTSTRAP_ENABLED=true

# --- Fila de geracao de chat (docs/allByQueue.md) ---
# Habilita o enfileiramento da geracao de respostas (rollback = false).
CHAT_QUEUE_ENABLED=true
# Maximo de geracoes simultaneas (teto global de Ollama). Inicio: 1.
# Subir so apos medir a GPU do servidor-alvo e alinhar com OLLAMA_NUM_PARALLEL.
CHAT_QUEUE_CONCURRENCY=1
# Timeout produtor->consumidor para a geracao de chat (ms). CPU e lento.
CHAT_QUEUE_TIMEOUT_MS=180000
# Janela de coalescencia dos chunks do LLM na reply queue (ms).
CHAT_QUEUE_CHUNK_FLUSH_MS=75
# (Fase 2) consumidores rodam em worker externo; nao iniciar in-process.
CHAT_WORKER_EXTERNAL=false

ROUTER_MODE=rules-first

# API interna do human-in-captcha usada para abrir chamado Cervello.
HUMAN_CAPTCHA_API_URL=http://127.0.0.1:3001
HUMAN_CAPTCHA_INTERNAL_TOKEN=dev-internal-token
HUMAN_CAPTCHA_AUTOMATION_TIMEOUT_MS=10000
HUMAN_CAPTCHA_CERVELLO_PROCESS_KEY=problemas-pedido-eletronico
HUMAN_CAPTCHA_MEDICATION_PRICE_PROCESS_KEY=medication-price-survey
HUMAN_CAPTCHA_CURRENCY_INDEX_PROCESS_KEY=coleta-indices-moedas

# Search-portal: consulta sincrona de precos de medicamentos por farmacia.
# Rodando no host (npm run dev), localhost resolve. Dentro do container, o
# docker-compose.local.yml sobrepoe para http://host.docker.internal:3110.
SEARCH_PORTAL_URL=http://localhost:3110
# URL publica exibida ao usuario. Se vazio, usa SEARCH_PORTAL_URL.
# SEARCH_PORTAL_PUBLIC_URL=http://localhost:3110
SEARCH_PORTAL_TIMEOUT_MS=15000
SEARCH_PORTAL_ALLOWED_SECTORS=desenvolvimento

# MCP-EDI: consulta read-only do EDI Oracle via Model Context Protocol.
# ATENCAO: em lib/config.ts o default e "ligado" (so `false` desliga). Sem um
# servidor MCP local, deixe explicitamente false.
MCP_EDI_ENABLED=false
MCP_EDI_URL=http://127.0.0.1:3440/mcp
MCP_EDI_TIMEOUT_MS=20000
MCP_EDI_ALLOWED_SECTORS=desenvolvimento

# Precisa bater com LOCAL_NEO4J_* do docker-compose.local.yml — a senha e
# gravada no volume neo4j_data na primeira subida.
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=sua_senha_aqui

# Dominio usado ao derivar e-mails de pessoas no grafo.
PERSON_EMAIL_DOMAIN=cidadela.com.br

# Microsoft Teams (Onda 1). Tambem default "ligado" em lib/config.ts: sem
# webhook provisionado, desligue localmente.
NOTIFICATIONS_ENABLED=false
# TEAMS_WEBHOOK_GAPS=
# TEAMS_WEBHOOK_DIGEST=
# NOTIFICATIONS_INTERVAL_MS=86400000
# WEEKLY_DIGEST_INTERVAL_MS=604800000

# Piloto Onda 2 (CSV de 5 usuarios reais, sem segredos).
# PILOT_USER_EMAILS=
# PILOT_SECTOR=
# PILOT_START_DATE=
# PILOT_SPONSOR=
# PILOT_CHAMPION=
