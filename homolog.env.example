# Copy to a protected file such as homolog.env and inject secrets from the
# approved secret manager. Do not commit real values.

APP_IMAGE=pfrm-secure-agents:homolog
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3030

AUTH_SECRET=replace-with-secret-manager-value
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://pfrm-secure-agents-hml.example.internal

DATABASE_URL=postgresql://pfrm_agents:replace@postgres-hml.example.internal:5432/pfrm_agents?sslmode=require

QDRANT_URL=https://qdrant-hml.example.internal:6333
QDRANT_API_KEY=replace-if-qdrant-requires-it
QDRANT_COLLECTION_SECURITY=rag_security
QDRANT_COLLECTION_SUPPORT=rag_support
QDRANT_COLLECTION_DEV=rag_dev
QDRANT_COLLECTION_DESKTOP=rag_desktop
QDRANT_STAGING_COLLECTION_SECURITY=rag_security_staging
QDRANT_STAGING_COLLECTION_SUPPORT=rag_support_staging
QDRANT_STAGING_COLLECTION_DEV=rag_dev_staging
QDRANT_STAGING_COLLECTION_DESKTOP=rag_desktop_staging
QDRANT_VECTOR_SIZE=1024

SOP_READINESS_THRESHOLD=0.75
CURATION_REQUIRES_OWNER_APPROVAL=true
CURATION_REQUIRES_ADMIN_APPROVAL=true
CURATION_ALLOW_SAME_USER_DUAL_APPROVAL=true

OLLAMA_URL=http://ollama-hml.example.internal:11434
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_CHAT_MODEL=qwen3.5:4b

RABBITMQ_URL=amqps://pfrm_agents:replace@rabbitmq-hml.example.internal:5671/pfrm_agents
RABBITMQ_MANAGEMENT_URL=https://rabbitmq-hml.example.internal
CHAT_TOP_K=5
CHAT_LOCAL_CONFIDENCE_THRESHOLD=0.50
BUS_RPC_TIMEOUT_MS=60000
BUS_BOOTSTRAP_ENABLED=true
ROUTER_MODE=rules-first

NEO4J_URI=neo4j+s://neo4j-hml.example.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-secret-manager-value

HUMAN_CAPTCHA_API_URL=http://human-automation-api:3001
HUMAN_CAPTCHA_INTERNAL_TOKEN=replace-when-integration-is-enabled
HUMAN_CAPTCHA_AUTOMATION_TIMEOUT_MS=10000
HUMAN_CAPTCHA_CERVELLO_PROCESS_KEY=problemas-pedido-eletronico
HUMAN_CAPTCHA_MEDICATION_PRICE_PROCESS_KEY=medication-price-survey
HUMAN_CAPTCHA_CURRENCY_INDEX_PROCESS_KEY=coleta-indices-moedas

SEARCH_PORTAL_URL=https://search-portal-hml.example.internal
SEARCH_PORTAL_PUBLIC_URL=https://search-portal-hml.example.internal
SEARCH_PORTAL_TIMEOUT_MS=15000
SEARCH_PORTAL_ALLOWED_SECTORS=desenvolvimento

MCP_EDI_ENABLED=false
MCP_EDI_URL=https://mcp-edi-hml.example.internal/mcp
MCP_EDI_TIMEOUT_MS=20000
MCP_EDI_ALLOWED_SECTORS=desenvolvimento

NOTIFICATIONS_ENABLED=false
# TEAMS_WEBHOOK_GAPS=
# TEAMS_WEBHOOK_DIGEST=
